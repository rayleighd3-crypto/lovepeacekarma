# TMDB API key (public demo key is acceptable for an addon; provide your own for higher rate limits)
TMDB_API_KEY=439c478a771f35c05022f9feabcca01c

# ShowBox (FebBox-backed). Paste your own `ui` cookie value from febbox.com (JWT):
#   open febbox.com, log in, DevTools -> Application -> Cookies -> copy the `ui` cookie value.
#   This is a long-lived JWT (rotates on account activity; current shape ~1-year expiry).
SHOWBOX_UI_COOKIE=eyJ...your.jwt.token...

# Optional: route provider requests through a proxy (e.g. ScraperAPI)
# HDHUB4U_PROXY_URL=

# 111477 file-host provider base URL (direct directory listings)
# PROVIDER_111477_BASE_URL=https://a.111477.xyz

# Optional: tweak per-provider search behavior
DEBUG=false
DISABLE_CACHE=false
